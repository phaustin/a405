ey":"XTCVfV11Qa"}],"key":"yCq7kAFICs"},{"type":"heading","depth":2,"position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"This notebook:","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"k4cSOJjqZp"}],"identifier":"this-notebook","label":"This notebook:","html_id":"this-notebook","implicit":true,"key":"r3if8IlDmE"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"1. Calculates the change in enthalpy at the surface and at 400 hPa, including both sensible and latent heat terms.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"jzDQIfJjyH"}],"key":"MsGuVy5jUW"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"2. Finds the total work done by the engine, and its efficiency.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"VkcHLArucL"}],"key":"hSs9mmE6Ck"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"3. Finds the percentage of the total heat change that is due to addition and remove of water\nduring the cycle.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"VPwKZzJmMJ"}],"key":"I5b6OYY1cN"}],"key":"w7p6kYPkmi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib import pyplot as plt\nimport numpy as np\nfrom a405.skewT.fullskew import makeSkewWet\nfrom a405.thermo.thermlib import find_esat, find_Td,find_thetaet,find_lcl,tinvert_thetae\nfrom a405.thermo.thermlib import find_lv, find_rsat\nfrom a405.thermo.thermlib import convertTempToSkew\nfrom a405.thermo.constants import constants as c\nfrom a405.utils.helper_funs import make_tuple","key":"OtboEI7EaI"},{"type":"outputs","id":"hFbYRSfFeqIfToUbPQFGM","children":[],"key":"Kke0PaGTv1"}],"key":"yXHoXwlqd6"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"A. get the surface enthalpy in the tropics (point A)","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"bo0VHBm5af"}],"identifier":"a-get-the-surface-enthalpy-in-the-tropics-point-a","label":"A. get the surface enthalpy in the tropics (point A)","html_id":"a-get-the-surface-enthalpy-in-the-tropics-point-a","implicit":true,"key":"Vw3NQwAGjL"}],"key":"wfpDYD5BbX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def calc_enthalpy(point_dict):\n    \"\"\"\n    Calculate the enthalpy and total water mixing ratio\n    for an air parcel, given a dictionary or parameters\n\n    Parameters\n    ----------\n    \n    point_dict: dictionary\n              dictionary with the following keys\n              ['id','temp','rv','rl','press']\n          units: point letter, K  kg/kg kg/kg Pa \n    \n    Returns\n    -------\n    \n    vals: named tuple\n         tuple with dictionary values plus rt (kg/kg)  and enthalpy (J/kg)\n    \"\"\"\n    point_dict['rt'] = point_dict['rv'] + point_dict['rl']\n    vals = make_tuple(point_dict)\n    cp = c.cpd + vals.rt*c.cl\n    point_dict['enthalpy'] =  cp*vals.temp + find_lv(vals.temp)*vals.rv\n    vals = make_tuple(point_dict)\n    return vals\n\ndef format_tup(the_tup):\n    \"\"\"\n    format a tuple returned from calc_enthalpy for output\n    \"\"\"\n    the_string=\"\"\"\n    point {id:}\n    temp: {temp:6.3f} K\n    press: {press:6.3g} Pa\n    rv:  {rv:6.3g} kg/kg\n    rl:  {rl:6.3g} kg/kg\n    rt:  {rt:6.3g} kg/kg\n    enthalpy: {enthalpy: 8.3g}  J/kg\n    \"\"\"\n    return the_string.format_map(the_tup._asdict())\n    \n   \npa2hPa = 1.e-2\nA_press = 1.e5  #Pa\nB_press = 4.e4  #Pa\nA_temp = 300  #K\nRH = 0.8\ne = find_esat(A_temp)*RH\nA_rv = c.eps*e/(A_press - e)\nA_Td = find_Td(A_rv,A_press)\nprint('tropical surface dewpoint: {} K'.format(A_Td))\nA_thetae=find_thetaet(A_Td,A_rv,A_temp,A_press)\nprint('tropical surface thetae: {} K'.format(A_thetae))\nA_temp,A_rv,A_rl = tinvert_thetae(A_thetae,A_rv,A_press)\nfields=['id','temp','rv','rl','press']\nA_dict = dict(zip(fields,('A',A_temp,A_rv,A_rl,A_press)))\nA_tup = calc_enthalpy(A_dict)\nprint(format_tup(A_tup))","key":"LunThc38NC"},{"type":"outputs","id":"3Y-5a3f6CApxcEUUX4UGX","children":[],"key":"keqLwkjydz"}],"key":"dVy9Z6FDal"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"B. Lift to 400 hPa and remove 80% of the liquid water","position":{"start":{"line":119,"column":1},"end":{"line":119,"column":1}},"key":"MZIv48cnH0"}],"identifier":"b-lift-to-400-hpa-and-remove-80-of-the-liquid-water","label":"B. Lift to 400 hPa and remove 80% of the liquid water","html_id":"b-lift-to-400-hpa-and-remove-80-of-the-liquid-water","implicit":true,"key":"cZHe9Tand6"}],"key":"ZpVtUqsF2W"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig,ax = plt.subplots(1,1,figsize=[10,8])\nax,skew = makeSkewWet(ax,corners=[-15,35])\n\nlcl_temp, lcl_press = find_lcl(A_Td,A_tup.temp,A_tup.press)\nxplot=convertTempToSkew(A_tup.temp - c.Tc,A_tup.press*pa2hPa,skew)\nbot=ax.plot(xplot, A_tup.press*pa2hPa-10., 'ko', markersize=14, markerfacecolor='k')\nax.text(xplot,A_tup.press*pa2hPa-20.,'A',fontsize=30)\npressrange=np.arange(1000,395.,-10.)\ntrop_adiabat=[]\nfor press in pressrange:\n    temp,rv,rl = tinvert_thetae(A_thetae,A_tup.rt,press*1.e2)\n    xtemp = convertTempToSkew(temp - c.Tc,press,skew)\n    trop_adiabat.append(xtemp)\nax.plot(trop_adiabat,pressrange,'r-',lw=10)\nB_press=400.e2  #Pa\ntemp,rv,rl = tinvert_thetae(A_thetae,A_tup.rt,B_press)\nrl = 0.2*rl  #rain out 80% of liquid\nB_dict = dict(zip(fields,('B',temp,rv,rl,B_press)))\nax.text(trop_adiabat[-1],B_press*pa2hPa,'B',fontsize=30)\nB_tup = calc_enthalpy(B_dict)\nprint(format_tup(B_tup))","key":"yQMjCPQ9TD"},{"type":"outputs","id":"yQN2AOzU23q2cfK5Mk1Ml","children":[],"key":"IDydWSHCf1"}],"key":"doz1b0bZQa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"top_temp,top_rv,top_rl = tinvert_thetae(A_thetae,B_tup.rt,B_tup.press)\nC_temp = top_temp - 20.\nC_rt = B_tup.rt  #conserve total water from B to C\nC_rv = find_rsat(C_temp,B_tup.press) \nC_rl = C_rt - C_rv  #cool and condense more liquid with constant rt\n\nC_dict = dict(zip(fields,('C',C_temp,C_rv,C_rl,B_tup.press)))\nC_tup = calc_enthalpy(C_dict)\nC_thetae = find_thetaet(C_tup.temp,C_tup.rt,C_tup.temp,B_tup.press)\nxplot=convertTempToSkew(C_tup.temp - c.Tc,C_tup.press*pa2hPa,skew)\ntop=ax.plot(xplot, C_tup.press*pa2hPa, 'ko', markersize=14, markerfacecolor='g')\nax.text(xplot*0.99, C_tup.press*pa2hPa,'C',fontsize=30)\nprint(format_tup(C_tup))\ndisplay(fig)","key":"gXVn5CcIn8"},{"type":"outputs","id":"p-Xw2yMDnNGtu8Si9rmlM","children":[],"key":"JVoLhlnlot"}],"key":"RcobPPTe49"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"children":[{"type":"text","value":"D. descend adiabatically to surface","position":{"start":{"line":162,"column":1},"end":{"line":162,"column":1}},"key":"yRzwL2eIZ3"}],"identifier":"d-descend-adiabatically-to-surface","label":"D. descend adiabatically to surface","html_id":"d-descend-adiabatically-to-surface","implicit":true,"key":"a6z7bocQhs"}],"key":"xMjb6We2v8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"C_adiabat=[]\nfor press in pressrange:\n    temp,rv,rl = tinvert_thetae(C_thetae,C_tup.rt,press*1.e2)\n    xtemp = convertTempToSkew(temp - c.Tc,press,skew)\n    C_adiabat.append(xtemp)\n#\n# now go to the surface\n#\npress=1000.\ntemp,rv,rl = tinvert_thetae(C_thetae,C_tup.rt,press*1.e2)\nD_dict = dict(zip(fields,('D',temp,rv,rl,press)))\nD_tup = calc_enthalpy(D_dict)\nax.plot(C_adiabat,pressrange,'b-',lw=10)\nax.text(C_adiabat[0]*1.03,pressrange[0],'D',fontsize=30)\nprint(format_tup(D_tup))\ndisplay(fig)","key":"O4zdZA6TDG"},{"type":"outputs","id":"PGSJw4BTsfm2R6kJSoH2w","children":[],"key":"AUHHdTVQ8W"}],"key":"Lq3KJTqt0u"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"children":[{"type":"text","value":"Questions","position":{"start":{"line":183,"column":1},"end":{"line":183,"column":1}},"key":"fw6oLBRq9p"}],"identifier":"questions","label":"Questions","html_id":"questions","implicit":true,"key":"O8MJT85pJE"},{"type":"paragraph","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"children":[{"type":"text","value":"In the cell below find:","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"key":"tTnRxhFwXK"}],"key":"Wpz7VW6h2H"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":187,"column":1},"end":{"line":190,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"the heating in and out ","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"key":"Xz0qXMUUTO"},{"type":"inlineMath","value":"Q_{in}","position":{"start":{"line":187,"column":1},"end":{"line":187,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>Q</mi><mrow><mi>i</mi><mi>n</mi></mrow></msub></mrow><annotation encoding=\"application/x-tex\">Q_{in}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\