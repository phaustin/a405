 as  your notebook","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"CCBgGgjEhK"}],"key":"c9GCJfW7Tw"}],"key":"wKGHOqSSKP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# load the properties of ammonium sulphate from JSON file\nfilename =  Path(\"ammonium_sulphate.json\")\nwith open(filename) as infile:\n    ammonium_sulphate = json.load(infile)\nammonium_sulphate","key":"HLuzW0mU3h"},{"type":"outputs","id":"PJKvJeQbnbgy3Jqfz01pa","children":[],"key":"cjml5KkyzD"}],"key":"VAvYHbai5a"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Making dictionaries more convenient","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"U1Bl6mp42K"}],"identifier":"making-dictionaries-more-convenient","label":"Making dictionaries more convenient","html_id":"making-dictionaries-more-convenient","implicit":true,"key":"hEFedqtiOw"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"The function below creates new claases of ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"II1D3XUhLO"},{"type":"link","url":"https://realpython.com/python-namedtuple/","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"named tuples","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"C7YatdaohG"}],"urlSource":"https://realpython.com/python-namedtuple/","key":"UDtndCokJ3"},{"type":"text","value":", which are more\nconvenient to use in equations than dictionaries because instead of typing ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"T1uMJKvL9k"},{"type":"inlineCode","value":"a['Sigma']","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"FrAkOAteU8"},{"type":"text","value":" you can type ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"f0G4iQptBt"},{"type":"inlineCode","value":"a.Sigma","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"rZOiTX2mDr"},{"type":"text","value":". Once you’ve defined the namedtuple class, you pass it a dictionary and\nit will generate a named tuple with attributes matching the dictionary keys.  My ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"nNGyECXLp0"},{"type":"inlineCode","value":"make_tuple","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"AVrV8a1SkD"},{"type":"text","value":" wrapper combines the namedtuple creation and the instance definition so you can turn a dictionary into a named tuple in one step.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"Pbk8XPBtPU"}],"key":"QNjvOOn1VO"}],"key":"tFFFxmaPE4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def make_tuple(in_dict: dict,tupname='values'):\n    \"\"\"\n    make a named tuple from a dictionary\n\n    Parameters\n    ----------\n\n    in_dict: dictionary\n         Any python object with key/value pairs\n\n    tupname: string\n         optional name for the new namedtuple type\n\n    Returns\n    -------\n\n    the_tup: namedtuple\n          named tuple with keys as attributes\n    \"\"\"\n    #\n    # create the class/type tup_class\n    #\n    tup_class = namedtuple(tupname, in_dict.keys())\n    #\n    # create an instance of the class with in_dict values\n    #\n    the_tup = tup_class(**in_dict)\n    return the_tup","key":"LsltDijtNz"},{"type":"outputs","id":"oyuW1-5mX-G4lEBiS4yng","children":[],"key":"CHkicRMXq2"}],"key":"FCHelLLpGA"},{"type":"block","children":[{"type":"heading","depth":4,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"The namedtuple version","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"EKldQAjWT8"}],"identifier":"the-namedtuple-version","label":"The namedtuple version","html_id":"the-namedtuple-version","implicit":true,"key":"DxA6ruaYZD"}],"key":"GDcu08YkHL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ammonium_sulphate = make_tuple(ammonium_sulphate)\nammonium_sulphate","key":"BDjfTQGyuz"},{"type":"outputs","id":"7R9yNLSDyl-TvmZ89aBkZ","children":[],"key":"lHuLTem6F6"}],"key":"D1ypj9Ex0S"},{"type":"block","children":[],"key":"nd7D7BNtiW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def find_S(r, aerosol, Temp):\n    \"\"\"\n    calculates supersaturation S given an aerosol dictionary,\n    temperature T, and droplet radius r \n    uses Thompkins 4.15\n\n    Parameters\n    ----------\n    r: radius (m)\n    aerosol: named tuple with attibutes: Sigma (N/m^2), vanHoff (int), Mw (kg/kmol), Ms (kg/kmol), mass (kg)\n    Temp: temperature (K)\n\n    Returns\n    -------\n    S: saturation (unitless)\n    \n    \"\"\"\n    # your code here\n    a=(2.*aerosol.Sigma)/(c.Rv*Temp*c.rhol)  #curvature term\n    b=(aerosol.vanHoff*aerosol.mass*aerosol.Mw)/((4./3.)*np.pi*c.rhol*aerosol.Ms)  #solution term\n    S = 1 + a/r - b/r**3.\n    return S","key":"fVP7H1fgMR"},{"type":"outputs","id":"pYntw7PTYe1bKpyr2txuI","children":[],"key":"yQ3AJ1lsFO"}],"key":"GK66rHpxsE"},{"type":"block","children":[],"key":"JSIbtwAYu7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# In this cell create a vector of radii r and use find_S to get the corresponding S values\n\nr = np.arange(0.01,3,0.01)*1.e-6\nTemp = 280.\nthe_S = find_S(r,ammonium_sulphate, Temp)\nthe_S[:10]","key":"J5KLdfViAY"},{"type":"outputs","id":"8vPawFUHnH4aRztmjpE8J","children":[],"key":"JEu5LOVyZ1"}],"key":"kAmSHUMuJK"},{"type":"block","children":[],"key":"LQXgKfndpH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# In this cell make an (x,y) plot of (r,S)\nfig, ax = plt.subplots(1,1)\nax.plot(r*1.e6,the_S)\nax.set_ylim([0.995,1.006])\nax.set_xlabel('radius (microns)')\nax.set_ylabel('Saturation S')\nax.grid(True)","key":"l0xqlJUbtR"},{"type":"outputs","id":"MMOygr9QXmW4GLbJq5BtW","children":[],"key":"NHT0MreTus"}],"key":"FFw9pxgCRl"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"text","value":"Question 2 -- rootfinding the equilibrium radius","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"zx7fafLQAe"}],"identifier":"question-2-rootfinding-the-equilibrium-radius","label":"Question 2 -- rootfinding the equilibrium radius","html_id":"question-2-rootfinding-the-equilibrium-radius","implicit":true,"key":"mDkB1Mbf2d"},{"type":"paragraph","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Use our rootfinder to find the equilibrium radius for a haze particle at a relative humidity of 90% and a temperature of 15 deg C","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"UWqeMzBrA7"}],"key":"DBxoZSv9FH"}],"key":"XaDqWLsp0C"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def find_r(RH,aerosol,Temp,leftbracket,right_bracket):\n    def S_diff(r,RH,aerosol,Temp):\n        Senv=RH*0.01\n        Sequil=find_S(r,aerosol,Temp)\n        the_diff = Senv - Sequil\n        print(f\"{r=},{Sequil=},{Senv=}\")\n        return the_diff\n    \n    args = (RH,aerosol,Temp)\n    \n    equil_r = optimize.brentq(S_diff,\n                             left_bracket,\n                             right_bracket,\n                             args = args)\n    return equil_r\n\nleft_bracket = 1.e-8\nright_bracket = 1.e-6\nRH = 90\nthe_r = find_r(RH,ammonium_sulphate,Temp,left_bracket,right_bracket)\nprint(f\"\\nequilibribum haze radius at {RH=} percent is {the_r*1.e6:.3f} microns\")","key":"YPaCpSRBqB"},{"type":"outputs","id":"wZuUF-6AlcBsYjRv_J9KJ","children":[],"key":"ruG8D4qaVO"}],"key":"lKUA8FK1Dk"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"Extra -- plot terms separately","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"mUw3b024Gn"}],"identifier":"extra-plot-terms-separately","label":"Extra -- plot terms separately","html_id":"extra-plot-terms-separately","implicit":true,"key":"PQMnhN3xK5"}],"key":"ZlHKGm3FMs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\ndef find_terms(r, aerosol, Temp):\n    \"\"\"\n    calculates supersaturation S given an aerosol dictionary,\n    temperature T, and droplet radius r \n    uses Thompkins 4.15\n\n    Parameters\n    ----------\n    r: radius (m)\n    aerosol: named tuple with attibutes: Sigma (N/m^2), vanHoff (int), Mw (kg/kmol), Ms (kg/kmol), mass (kg)\n    Temp: temperature (K)\n\n    Returns\n    -------\n    S: saturation (unitless)\n    \n    \"\"\"\n    # your code here\n    a=(2.*aerosol.Sigma)/(c.Rv*Temp*c.rhol)  #curvature term\n    b=(aerosol.vanHoff*aerosol.mass*aerosol.Mw)/((4./3.)*np.pi*c.rhol*aerosol.Ms)  #solution term\n    S = 1 + a/r - b/r**3.\n    out_dict=dict(a=a/r,b=b/r**3.,S = S)\n    return out_dict","key":"OsZZvbTYdv"},{"type":"outputs","id":"aCc_O3RHZyt2ltsYgfpoR","children":[],"key":"nt3yIUm0FC"}],"key":"daADfMlGGE"},{"type":"block","children":[],"key":"ElsU9Q2pxo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"rlist = np.arange(0.002,3,0.01)*1.e-6\nTemp = 280.\nterm_list = [find_terms(r,ammonium_sulphate, Temp) for r in rlist]\nthe_frame = pd.DataFrame.from_records(term_list)\nfig, ax = plt.subplots(1,1)\nrplot=rlist*1.e6\nax.plot(rplot,the_frame['a'],label='a/r')\nax.plot(rplot,-the_frame['b'],label='-b/r**3.')\nax.plot(rplot,the_frame['S']-1,label='S-1')\nax.set_xlim(0,0.5)\nax.set_ylim(-0.03,0.03)\nax.grid(True)\nax.legend()\nfig.savefig(\"terms.jpg\")","key":"ROlawjh6Cw"},{"type":"outputs","id":"73m6JlRksjqAjs4zrYaM1","children":[],"key":"Un0lgg8Mzv"}],"key":"Jp5q6hp3jH"},{"type":"block","children":[],"key":"bElOE3c6MK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"gfVLRF8qlQ"},{"type":"outputs","id":"eyft_5k6hTpsLWYpjMGzp","children":[],"key":"MIoQGemSvF"}],"key":"YfSkwcxKZi"}],"key":"IlBmF9CTo6"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Worksheet 8: Interp1d Solution","url":"/notebooks/worksheets/worksheet8-interp1d-solution","group":"Worksheets"},"next":{"title":"Worksheet 10: Aerosol distributions solution","url":"/notebooks/worksheets/worksheet10-aero-dist-solution","group":"Worksheets"}}},"domain":"http://pre.render"}