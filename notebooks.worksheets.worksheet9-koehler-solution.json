e":" into the same folder as  your notebook","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"FOa8V1scZC"}],"key":"Ovfc8jmrk5"}],"key":"XX5g8EA3TF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# load the properties of ammonium sulphate from JSON file\nfilename =  Path(\"ammonium_sulphate.json\")\nwith open(filename) as infile:\n    ammonium_sulphate = json.load(infile)\nammonium_sulphate","key":"BtaVbfOLIh"},{"type":"outputs","id":"EEvIj3Inepx5fmCDYlZmK","children":[],"key":"yCmKJIkVRc"}],"key":"gGAKwjl2Hj"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"Making dictionaries more convenient","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"Q6dwC6shKY"}],"identifier":"making-dictionaries-more-convenient","label":"Making dictionaries more convenient","html_id":"making-dictionaries-more-convenient","implicit":true,"key":"hnxAkaxrEK"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"The function below creates new claases of ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"oDVj48uuYn"},{"type":"link","url":"https://realpython.com/python-namedtuple/","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"named tuples","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"ZhRkwj0kVn"}],"urlSource":"https://realpython.com/python-namedtuple/","key":"lrVRKdl0AL"},{"type":"text","value":", which are more\nconvenient to use in equations than dictionaries because instead of typing ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"UbNlNnLMic"},{"type":"inlineCode","value":"a['Sigma']","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"fFF3MRDIeC"},{"type":"text","value":" you can type ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"BRv2yZJluY"},{"type":"inlineCode","value":"a.Sigma","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"LI3f8kOZny"},{"type":"text","value":". Once you’ve defined the namedtuple class, you pass it a dictionary and\nit will generate a named tuple with attributes matching the dictionary keys.  My ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"KDDmH6k2f5"},{"type":"inlineCode","value":"make_tuple","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"abloo6pXne"},{"type":"text","value":" wrapper combines the namedtuple creation and the instance definition so you can turn a dictionary into a named tuple in one step.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"l7yQIzX85V"}],"key":"v0S3rSxTOT"}],"key":"ZGXHf1a1xJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def make_tuple(in_dict: dict,tupname='values'):\n    \"\"\"\n    make a named tuple from a dictionary\n\n    Parameters\n    ----------\n\n    in_dict: dictionary\n         Any python object with key/value pairs\n\n    tupname: string\n         optional name for the new namedtuple type\n\n    Returns\n    -------\n\n    the_tup: namedtuple\n          named tuple with keys as attributes\n    \"\"\"\n    #\n    # create the class/type tup_class\n    #\n    tup_class = namedtuple(tupname, in_dict.keys())\n    #\n    # create an instance of the class with in_dict values\n    #\n    the_tup = tup_class(**in_dict)\n    return the_tup","key":"t1jbgt7cAN"},{"type":"outputs","id":"eg7_njbzp_ExDGUU6TiS_","children":[],"key":"M9H3nRHQb2"}],"key":"nUBCsDekeG"},{"type":"block","children":[{"type":"heading","depth":4,"position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"The namedtuple version","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"bYYmSUTHL1"}],"identifier":"the-namedtuple-version","label":"The namedtuple version","html_id":"the-namedtuple-version","implicit":true,"key":"oTzejsajlv"}],"key":"VBTNSXecow"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ammonium_sulphate = make_tuple(ammonium_sulphate)\nammonium_sulphate","key":"raUBQHbBBK"},{"type":"outputs","id":"jNXKH_ruaI5evfWkAhMo7","children":[],"key":"LfGFBIIoxS"}],"key":"GfIhzDf4Aw"},{"type":"block","children":[],"key":"D3ssOkHZXC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def find_S(r, aerosol, Temp):\n    \"\"\"\n    calculates supersaturation S given an aerosol dictionary,\n    temperature T, and droplet radius r \n    uses Thompkins 4.15\n\n    Parameters\n    ----------\n    r: radius (m)\n    aerosol: named tuple with attibutes: Sigma (N/m^2), vanHoff (int), Mw (kg/kmol), Ms (kg/kmol), mass (kg)\n    Temp: temperature (K)\n\n    Returns\n    -------\n    S: saturation (unitless)\n    \n    \"\"\"\n    # your code here\n    a=(2.*aerosol.Sigma)/(c.Rv*Temp*c.rhol)  #curvature term\n    b=(aerosol.vanHoff*aerosol.mass*aerosol.Mw)/((4./3.)*np.pi*c.rhol*aerosol.Ms)  #solution term\n    S = 1 + a/r - b/r**3.\n    return S","key":"hBYzHZnT2V"},{"type":"outputs","id":"cPNpML8IUYOnJdHvXV8dq","children":[],"key":"szfihrD92O"}],"key":"hKysNmmGE5"},{"type":"block","children":[],"key":"tTebXh7AkG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# In this cell create a vector of radii r and use find_S to get the corresponding S values\n\nr = np.arange(0.01,3,0.01)*1.e-6\nTemp = 280.\nthe_S = find_S(r,ammonium_sulphate, Temp)\nthe_S[:10]","key":"GOOfEv1PfE"},{"type":"outputs","id":"B_zJ1DyD1QEUuv58l-DQq","children":[],"key":"SbCIam66wB"}],"key":"O9fKuoT0Ub"},{"type":"block","children":[],"key":"maZa91tp0f"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# In this cell make an (x,y) plot of (r,S)\nfig, ax = plt.subplots(1,1)\nax.plot(r*1.e6,the_S)\nax.set_ylim([0.995,1.006])\nax.set_xlabel('radius (microns)')\nax.set_ylabel('Saturation S')\nax.grid(True)","key":"UR8CKolVTO"},{"type":"outputs","id":"6ttdlY7_KElOky-DecfXS","children":[],"key":"SBSRzXHupn"}],"key":"FpMhMd3z8n"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"text","value":"Question 2 -- rootfinding the equilibrium radius","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"PEXwcnavZC"}],"identifier":"question-2-rootfinding-the-equilibrium-radius","label":"Question 2 -- rootfinding the equilibrium radius","html_id":"question-2-rootfinding-the-equilibrium-radius","implicit":true,"key":"NVn5aQE8Qm"},{"type":"paragraph","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Use our rootfinder to find the equilibrium radius for a haze particle at a relative humidity of 90% and a temperature of 15 deg C","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"E7SNOBS67W"}],"key":"bZzHV0Tirf"}],"key":"zTAoVdS5Zk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def find_r(RH,aerosol,Temp,leftbracket,right_bracket):\n    def S_diff(r,RH,aerosol,Temp):\n        Senv=RH*0.01\n        Sequil=find_S(r,aerosol,Temp)\n        the_diff = Senv - Sequil\n        print(f\"{r=},{Sequil=},{Senv=}\")\n        return the_diff\n    \n    args = (RH,aerosol,Temp)\n    \n    equil_r = optimize.brentq(S_diff,\n                             left_bracket,\n                             right_bracket,\n                             args = args)\n    return equil_r\n\nleft_bracket = 1.e-8\nright_bracket = 1.e-6\nRH = 90\nthe_r = find_r(RH,ammonium_sulphate,Temp,left_bracket,right_bracket)\nprint(f\"\\nequilibribum haze radius at {RH=} percent is {the_r*1.e6:.3f} microns\")","key":"SPNe4VU26T"},{"type":"outputs","id":"iv-XvmkmZskfrrD9Twp-E","children":[],"key":"llypIsLnV4"}],"key":"gjoAx6hkrT"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"children":[{"type":"text","value":"Extra -- plot terms separately","position":{"start":{"line":184,"column":1},"end":{"line":184,"column":1}},"key":"FERFLXX3T7"}],"identifier":"extra-plot-terms-separately","label":"Extra -- plot terms separately","html_id":"extra-plot-terms-separately","implicit":true,"key":"A7uzQlf4Ug"}],"key":"M0AeAKxzju"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pandas as pd\ndef find_terms(r, aerosol, Temp):\n    \"\"\"\n    calculates supersaturation S given an aerosol dictionary,\n    temperature T, and droplet radius r \n    uses Thompkins 4.15\n\n    Parameters\n    ----------\n    r: radius (m)\n    aerosol: named tuple with attibutes: Sigma (N/m^2), vanHoff (int), Mw (kg/kmol), Ms (kg/kmol), mass (kg)\n    Temp: temperature (K)\n\n    Returns\n    -------\n    S: saturation (unitless)\n    \n    \"\"\"\n    # your code here\n    a=(2.*aerosol.Sigma)/(c.Rv*Temp*c.rhol)  #curvature term\n    b=(aerosol.vanHoff*aerosol.mass*aerosol.Mw)/((4./3.)*np.pi*c.rhol*aerosol.Ms)  #solution term\n    S = 1 + a/r - b/r**3.\n    out_dict=dict(a=a/r,b=b/r**3.,S = S)\n    return out_dict","key":"PWAIhCkbsk"},{"type":"outputs","id":"1HU6B-dMSrHyM5duaLa6e","children":[],"key":"rhp3BYUBXE"}],"key":"RY0D0l7Gk7"},{"type":"block","children":[],"key":"neJswvoB8w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"rlist = np.arange(0.002,3,0.01)*1.e-6\nTemp = 280.\nterm_list = [find_terms(r,ammonium_sulphate, Temp) for r in rlist]\nthe_frame = pd.DataFrame.from_records(term_list)\nfig, ax = plt.subplots(1,1)\nrplot=rlist*1.e6\nax.plot(rplot,the_frame['a'],label='a/r')\nax.plot(rplot,-the_frame['b'],label='-b/r**3.')\nax.plot(rplot,the_frame['S']-1,label='S-1')\nax.set_xlim(0,0.5)\nax.set_ylim(-0.03,0.03)\nax.grid(True)\nax.legend()\nfig.savefig(\"terms.jpg\")","key":"g9UblqyhxB"},{"type":"outputs","id":"e-IQ4d_njY5PSyBsas8t-","children":[],"key":"vJs3ovGSvm"}],"key":"ZBqSQzw7fL"},{"type":"block","children":[],"key":"GNqB6YMwKg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"w6Gh0x8EGE"},{"type":"outputs","id":"RH3KS1wuIArlAPN0sTP0l","children":[],"key":"ry7hcJ13vJ"}],"key":"T6U5b02XYp"}],"key":"jYm0RcoyJk"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Worksheet 8: Interp1d Solution","url":"/notebooks/worksheets/worksheet8-interp1d-solution","group":"Worksheets"},"next":{"title":"Worksheet 10: Aerosol distributions solution","url":"/notebooks/worksheets/worksheet10-aero-dist-solution","group":"Worksheets"}}},"domain":"http://pre.render"}