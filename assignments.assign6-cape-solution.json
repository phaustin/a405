-use-calc-interp-to-construct-interpolators","label":"From Assignb 6 part 1: use calc_interp to construct interpolators","html_id":"from-assignb-6-part-1-use-calc-interp-to-construct-interpolators","implicit":true,"key":"W5fJ0hvmtw"}],"key":"qlM74vXoWz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport xarray as xr\nfrom matplotlib import pyplot as plt\nfrom scipy.interpolate import interp1d\nimport numpy as np\n\ndef calc_interp(entrain_ds):\n    press = entrain_ds['env_press'].values\n    envHeight = entrain_ds['env_height'].values\n    temp = entrain_ds['env_temp'].values\n    dewpoint = entrain_ds['env_dewpoint'].values\n    emvHeight = nudge(envHeight)\n    interpTenv = interp1d(envHeight,temp)\n    interpTdEnv = interp1d(envHeight,dewpoint)\n    interpPress = interp1d(envHeight,press)\n    return interpTenv,interpTdEnv,interpPress","key":"H4YN5WjOSf"},{"type":"outputs","id":"9ZZeI6n6L35tJ_ARoay0l","children":[],"key":"Ur2LS7hVfd"}],"key":"IOopf1tRC1"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Read in the entrainment run","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"CN7PsjWQUh"}],"identifier":"read-in-the-entrainment-run","label":"Read in the entrainment run","html_id":"read-in-the-entrainment-run","implicit":true,"key":"jpn8fbZiZh"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Read in the file produced by ","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"XDbqT2dvJa"},{"type":"link","kind":"ref","identifier":"entrain_cloud","label":"entrain_cloud","url":"/notebooks/worksheets/entraining-plume","internal":true,"dataUrl":"/notebooks.worksheets.entraining-plume.json","children":[{"type":"text","value":"Modeling an entraining cloud updraft try","key":"uHF9BS2QWv"}],"key":"tkJGQKVmDt"}],"key":"fEypMVZiuv"}],"key":"cx1Z72fgUy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"in_file = Path() / \"little_rock_july_9.nc\"\nif not in_file.exists():\n    raise Exception(f\"missing input file {in_file.absolute()}\")\nentrain_ds = xr.open_dataset(in_file)\nentrain_ds","key":"XJ2UckFgR3"},{"type":"outputs","id":"2eqsVutbOKOlWU8awGN87","children":[],"key":"jeo9CuCRJ2"}],"key":"cdCffYvFHw"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"copy get_buoy from the cape notebook","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"OPE0W8E9JM"}],"identifier":"copy-get-buoy-from-the-cape-notebook","label":"copy get_buoy from the cape notebook","html_id":"copy-get-buoy-from-the-cape-notebook","implicit":true,"key":"WHLPbszpbz"}],"key":"XFRXUsQPAM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from numpy.typing import ArrayLike as array\nimport cloudlib.thermo.thermfn as tl\nfrom cloudlib.thermo.constants import constants as c\n\n\ndef get_buoy(T_env: array, Td_env: array, T_cloud: array, press: array) -> array:\n    \"\"\"\n    Given an atmospheric sounding (Temperature and dew point profiles),\n    calculate the buoyant force per unit mass (m/s2) of cloud air previously\n    calculated from the entraining parcel notebook\n\n    Parameters\n    ----------\n    Tenv, Tdenv, Tcloud and press all need to be the same length\n\n    Tenv:  environmental emperature profile (K)\n    Tdenv:  environmental dew point temperature profile (K)\n    pres: Pressures at which to calculate B (Pa)\n\n    Returns\n    -------\n\n    B: Buoyancy per unit mass (m/s2)\n\n    \"\"\"\n    rv_cloud = tl.find_rsat(T_cloud,press)\n    Tv_cloud = tl.find_Tv(T_cloud, rv_cloud)\n   \n    rv_env = tl.find_rsat(Td_env, press)\n    Tv_env = tl.find_Tv(T_env, rv_env)\n    \n    # Thompkins 1.61\n    buoy = c.g0 * (Tv_cloud - Tv_env) / Tv_env\n    return buoy","key":"tFIk9t5eNE"},{"type":"outputs","id":"kgZ-i_Okk0gHQbKNBQnEX","children":[],"key":"w5c13b6Xh1"}],"key":"ypcPDoek9i"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"interpolate to the cloud pressure levels","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"GUc5coK3QA"}],"identifier":"interpolate-to-the-cloud-pressure-levels","label":"interpolate to the cloud pressure levels","html_id":"interpolate-to-the-cloud-pressure-levels","implicit":true,"key":"XVfnJHmdJl"}],"key":"BNAoldRbII"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"interpTenv,interpTdEnv,interpPress = calc_interp(entrain_ds)\neven_height=entrain_ds['cloud_height'].values\neven_press=interpPress(even_height)*c.hPa2pa\neven_temp = interpTenv(even_height) + c.Tc\neven_dew = interpTdEnv(even_height) + c.Tc\nwvel = entrain_ds['wvel'].values\ncloud_temp = entrain_ds['cloud_temp'].values\n\nbuoy = get_buoy(even_temp, even_dew, cloud_temp, even_press)","key":"jSmyYBW3lw"},{"type":"outputs","id":"9dmNTPLJIsJoFvVgE4F9Q","children":[],"key":"WpFp18pR8O"}],"key":"Of9bxS9MWn"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"plot temperatures, buoyancy and vertical velocity","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"nRKt2jimzt"}],"identifier":"plot-temperatures-buoyancy-and-vertical-velocity","label":"plot temperatures, buoyancy and vertical velocity","html_id":"plot-temperatures-buoyancy-and-vertical-velocity","implicit":true,"key":"r7GOnNX