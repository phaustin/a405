-use-calc-interp-to-construct-interpolators","label":"From Assignb 6 part 1: use calc_interp to construct interpolators","html_id":"from-assignb-6-part-1-use-calc-interp-to-construct-interpolators","implicit":true,"key":"uJM8liEBnO"}],"key":"aZxtmnztJo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pathlib import Path\nimport xarray as xr\nfrom matplotlib import pyplot as plt\nfrom scipy.interpolate import interp1d\nimport numpy as np\n\ndef calc_interp(entrain_ds):\n    press = entrain_ds['env_press'].values\n    envHeight = entrain_ds['env_height'].values\n    temp = entrain_ds['env_temp'].values\n    dewpoint = entrain_ds['env_dewpoint'].values\n    emvHeight = nudge(envHeight)\n    interpTenv = interp1d(envHeight,temp)\n    interpTdEnv = interp1d(envHeight,dewpoint)\n    interpPress = interp1d(envHeight,press)\n    return interpTenv,interpTdEnv,interpPress","key":"a6gcbBeUg4"},{"type":"outputs","id":"v4AzIhqcHej8JHbZ889vn","children":[],"key":"T34CtxcbHm"}],"key":"wofxfWbuSn"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"children":[{"type":"text","value":"Read in the entrainment run","position":{"start":{"line":82,"column":1},"end":{"line":82,"column":1}},"key":"CI0ZZ9vMbP"}],"identifier":"read-in-the-entrainment-run","label":"Read in the entrainment run","html_id":"read-in-the-entrainment-run","implicit":true,"key":"S80rQd8WH0"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Read in the file produced by ","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"bazghlfeYN"},{"type":"link","kind":"ref","identifier":"entrain_cloud","label":"entrain_cloud","url":"/notebooks/worksheets/entraining-plume","internal":true,"dataUrl":"/notebooks.worksheets.entraining-plume.json","children":[{"type":"text","value":"Modeling an entraining cloud updraft try","key":"YR0POK9FiW"}],"key":"ijjT3VB75C"}],"key":"ARRQkWhZ1y"}],"key":"Ldi9w6XmIq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"in_file = Path() / \"little_rock_july_9.nc\"\nif not in_file.exists():\n    raise Exception(f\"missing input file {in_file.absolute()}\")\nentrain_ds = xr.open_dataset(in_file)\nentrain_ds","key":"Sk64DprEN2"},{"type":"outputs","id":"sdqq6W3Wr8GGgIbD6UJi7","children":[],"key":"NKqfeZYQWL"}],"key":"GdtaEqnl1O"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"children":[{"type":"text","value":"copy get_buoy from the cape notebook","position":{"start":{"line":94,"column":1},"end":{"line":94,"column":1}},"key":"hfRc6F9AT2"}],"identifier":"copy-get-buoy-from-the-cape-notebook","label":"copy get_buoy from the cape notebook","html_id":"copy-get-buoy-from-the-cape-notebook","implicit":true,"key":"HofXC7mvpP"}],"key":"ZM8fQWR44z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from numpy.typing import ArrayLike as array\nimport cloudlib.thermo.thermfn as tl\nfrom cloudlib.thermo.constants import constants as c\n\n\ndef get_buoy(T_env: array, Td_env: array, T_cloud: array, press: array) -> array:\n    \"\"\"\n    Given an atmospheric sounding (Temperature and dew point profiles),\n    calculate the buoyant force per unit mass (m/s2) of cloud air previously\n    calculated from the entraining parcel notebook\n\n    Parameters\n    ----------\n    Tenv, Tdenv, Tcloud and press all need to be the same length\n\n    Tenv:  environmental emperature profile (K)\n    Tdenv:  environmental dew point temperature profile (K)\n    pres: Pressures at which to calculate B (Pa)\n\n    Returns\n    -------\n\n    B: Buoyancy per unit mass (m/s2)\n\n    \"\"\"\n    rv_cloud = tl.find_rsat(T_cloud,press)\n    Tv_cloud = tl.find_Tv(T_cloud, rv_cloud)\n   \n    rv_env = tl.find_rsat(Td_env, press)\n    Tv_env = tl.find_Tv(T_env, rv_env)\n    \n    # Thompkins 1.61\n    buoy = c.g0 * (Tv_cloud - Tv_env) / Tv_env\n    return buoy","key":"RfCKy2gKcz"},{"type":"outputs","id":"K2J0lNElJTJl2nm22djwE","children":[],"key":"pMSAjCAEis"}],"key":"fTphWFFjpe"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"interpolate to the cloud pressure levels","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"HRcvtwDUdg"}],"identifier":"interpolate-to-the-cloud-pressure-levels","label":"interpolate to the cloud pressure levels","html_id":"interpolate-to-the-cloud-pressure-levels","implicit":true,"key":"jbL4y7Jgd5"}],"key":"kfcDLkJcqJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"interpTenv,interpTdEnv,interpPress = calc_interp(entrain_ds)\neven_height=entrain_ds['cloud_height'].values\neven_press=interpPress(even_height)*c.hPa2pa\neven_temp = interpTenv(even_height) + c.Tc\neven_dew = interpTdEnv(even_height) + c.Tc\nwvel = entrain_ds['wvel'].values\ncloud_temp = entrain_ds['cloud_temp'].values\n\nbuoy = get_buoy(even_temp, even_dew, cloud_temp, even_press)","key":"tYvNJFaT8s"},{"type":"outputs","id":"vtkkqHw2AOg6QUbmZ2hPs","children":[],"key":"tUIx3Sds7w"}],"key":"PA2mhv1j4Y"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"children":[{"type":"text","value":"plot temperatures, buoyancy and vertical velocity","position":{"start":{"line":147,"column":1},"end":{"line":147,"column":1}},"key":"ARjCbfizaQ"}],"identifier":"plot-temperatures-buoyancy-and-vertical-velocity","label":"plot temperatures, buoyancy and vertical velocity","html_id":"plot-temperatures-buoyancy-and-vertical-velocity","implicit":true,"key":"o3PnDoI7lX"}],"key":"RFdgN5N1al"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, (ax1, ax2, ax3) = plt.subplots(1,3,figsize=(10,6))\nax1.plot(cloud_temp,even_press,label=\"cloud\")\nax1.plot(even_temp,even_press,label=\"env\")\nax1.set_xlabel(\"temperature (K)\")\nax1.set_ylabel(\"pressure (Pa)\")\nax1.invert_yaxis()\nax1.grid(True)\nax1.set_title(\"environmental and cloud temperture\")\nax1.legend()\nax2.invert_yaxis()\nax2.plot(buoy,even_press)\nax2.axes.get_yaxis().set_visible(False)\nax2.grid(True)\nax2.set_xlabel(\"B (m/s^2)\")\nax2.set_title(\"Buoyancy\")\nax3.plot(wvel,even_press)\nax3.axes.get_yaxis().set_visible(False)\nax3.set_xlabel(\"$w_{vel}$ (m/s)\")\nax3.set_title(\"vertical velocity\")","key":"tCekMC7HmY"},{"type":"outputs","id":"syZi8avwCfYDU3mIHJz6M","children":[],"key":"sCuXu3LpMj"}],"key":"nqElSBxfHt"},{"type":"block","children":[],"key":"qU7NfkHJJK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib import pyplot as plt","key":"gpUFLjT6TT"},{"type":"outputs","id":"7bTWEpor71d8jgkwpfE9S","children":[],"key":"m6JrkLX7z6"}],"key":"xLtloE4MKb"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"children":[{"type":"text","value":"Calculate the cape and ","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"key":"qlQJnLulYX"},{"type":"inlineMath","value":"\\sqrt{2*\\text{CAPE}}","position":{"start":{"line":175,"column":1},"end":{"line":175,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msqrt><mrow><mn>2</mn><mo>∗</mo><mtext>CAPE</mtext></mrow></msqrt></mrow><annotation encoding=\"application/x-tex\">\\sqrt{2*\\text{CAPE}}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base