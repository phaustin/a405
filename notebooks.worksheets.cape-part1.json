ngs['attributes']['units'].split(';')\nunits_dict={}\nfor count,var in enumerate(sounding.columns[1:]):\n    units_dict[var]=units[count]\n#\n# use the pretty printer to print the dictionary\n#\nprint(f'units: {pformat(units_dict)}')","key":"fCJidOOmyA"},{"type":"outputs","id":"lrV95OG4uFL98OnrI-Itd","children":[],"key":"QWbLgB4t6c"}],"key":"HwYtzfFJBi"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Convert temperature and dewpoint to skew coords","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"fjA01LtABw"}],"identifier":"convert-temperature-and-dewpoint-to-skew-coords","label":"Convert temperature and dewpoint to skew coords","html_id":"convert-temperature-and-dewpoint-to-skew-coords","implicit":true,"key":"hjekd21aER"}],"key":"dSA812vJyy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"skew=35.\ntriplets=zip(sounding['temp'],sounding['dwpt'],sounding['pres'])\nxcoord_T=[]\nxcoord_Td=[]\nfor a_temp,a_dew,a_pres in triplets:\n    xcoord_T.append(convertTempToSkew(a_temp,a_pres,skew))\n    xcoord_Td.append(convertTempToSkew(a_dew,a_pres,skew))","key":"B7fOK4gwya"},{"type":"outputs","id":"GhlI0vG94L1v1-8b0O8J7","children":[],"key":"ZZ1BPYnbc7"}],"key":"rw17BXkARL"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"children":[{"type":"text","value":"Plot the sounding","position":{"start":{"line":92,"column":1},"end":{"line":92,"column":1}},"key":"NLj0hWQcBr"}],"identifier":"plot-the-sounding","label":"Plot the sounding","html_id":"plot-the-sounding","implicit":true,"key":"hTdqeKHYaC"}],"key":"SZpL8XfsOe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def label_fun():\n    \"\"\"\n    override the default rs labels with a tighter mesh\n    \"\"\"\n    from numpy import arange\n    #\n    # get the default labels\n    #\n    tempLabels,rsLabels, thetaLabels, thetaeLabels = make_default_labels()\n    #\n    # change the temperature and rs grids\n    #\n    tempLabels = range(-40, 50, 2)\n    rsLabels = [0.1, 0.25, 0.5, 1, 2, 3] + list(np.arange(4, 28, 2)) \n    return tempLabels,rsLabels, thetaLabels, thetaeLabels","key":"eE4Sh4sqbD"},{"type":"outputs","id":"ixk1ERUdvMabasCl4GJtR","children":[],"key":"GwbI7DH5E4"}],"key":"lLD7aKmYOS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig,ax =plt.subplots(1,1,figsize=(8,8))\ncorners = [10, 35]\nax, skew = makeSkewWet(ax, corners=corners, skew=skew,label_fun=label_fun)\n#ax,skew = makeSkewWet(ax,corners=corners,skew=skew)\nout=ax.set(title=title_string)\nxcorners=find_corners(corners,skew=skew)\nax.set(xlim=xcorners,ylim=[1000,200]);\nl1,=ax.plot(xcoord_T,sounding['pres'],color='k',label='temp')\nl2,=ax.plot(xcoord_Td,sounding['pres'],color='g',label='dew')\n[line.set(linewidth=3) for line in [l1,l2]];","key":"X7Cf7tCFDG"},{"type":"outputs","id":"j8d__EiLo2FaFfrKr1KTz","children":[],"key":"DZ10N54tHw"}],"key":"RQZOoKRFec"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"Turn off log(0) warning","position":{"start":{"line":125,"column":1},"end":{"line":125,"column":1}},"key":"etUSPz3omz"}],"identifier":"turn-off-log-0-warning","label":"Turn off log(0) warning","html_id":"turn-off-log-0-warning","implicit":true,"key":"g2PsTGvX3H"}],"key":"r9S6vxTFFN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"np.seterr(all='ignore');","key":"heHU2ofDF7"},{"type":"outputs","id":"1WklEFRUTnhkWphqzkRzs","children":[],"key":"s8USlkcNRC"}],"key":"sd0FFwK76K"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"CAPE calculation","position":{"start":{"line":131,"column":1},"end":{"line":131,"column":1}},"key":"j6YwhDZw7L"}],"identifier":"cape-calculation","label":"CAPE calculation","html_id":"cape-calculation","implicit":true,"key":"a9NrVJznTC"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"The function below finds the buoyancy defined by Thompkins eq. 1.61 as a function of height, where Tv,a is the virtual temperature of the pseudoadiabat and Tv,env is the virtual temperature of your particular environmental sounding as a function of height using the lowest level to calculate the thetae for the moist adiabat. Check in a notebook that extends cape_part1_html by defining the function (ok to copy code from my library), running it and plotting it vs. height.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"nVlvDebOjH"}],"key":"I3KV4czrQL"},{"type":"thematicBreak","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"vBwcUCTV1B"},{"type":"paragraph","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Thompkins equation 1.61:","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"a4nEBNWHzz"}],"key":"Ed0OcCjjsE"}],"key":"tHEhCmi6F2"},{"type":"math","value":"B = g\\left(\\frac{T_{v,a}-T_{v,env}}{T_{v,env}}\\right)","position":{"start":{"line":139,"column":1},"end":{"line":141,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>B</mi><mo>=</mo><mi>g</mi><mrow><mo fence=\"true\">(</mo><mfrac><mrow><msub><mi>T</mi><mrow><mi>v</mi><mo separator=\"true\">,</mo><mi>a</mi></mrow></msub><mo>−</mo><msub><mi>T</mi><mrow><mi>v</mi><mo separator=\"true\">,</mo><mi>e</mi><mi>n</mi><mi>v</mi></mrow></msub></mrow><msub><mi>T</mi><mrow><mi>v</mi><mo separator=\"true\">,</mo><mi>e</mi><mi>n</mi><mi>v</mi></mrow></msub></mfrac><mo fence=\"true\">)</mo></mrow></mrow><annotation encoding=\"application/x-tex\">B = g\\left(\\frac{T_{v,a}-T_{v,env}}{T_{v,env}}\\right)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6833em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.05017em;\">B</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.4221em;vertical-align:-0.9721em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">g</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"minner\"><span class=\"mopen delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">(</span></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3603em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.1389em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.03588em;\">v</span><span class=\"mpunct mtight\">,</span><span class=\"mord mathnormal mtight\">e</span><span class=\"mord mathnormal mtight\">n</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.03588em;\">v</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.1389em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.03588em;\">v</span><span class=\"mpunct mtight\">,</span><span class=\"mord mathnormal mtight\">a</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.1389em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.03588em;\">v</span><span class=\"mpunct mtight\">,</span><span class=\"mord mathnormal mtight\">e</span><span class=\"mord mathnormal mtight\">n</span><span class=\"mord mathnormal mtight\" style=\"margin-right:0.03588em;\">v</span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.2861em;\"><span></span></span></span></span></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.9721em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mclose delimcenter\" style=\"top:0em;\"><span class=\"delimsizing size3\">)</span></span></span></span></span></span></span>","enumerator":"1","key":"Fnt3KjZ6me"}],"key":"R95roQovoC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from numpy.typing import ArrayLike as array\nimport cloudlib.thermo.thermfn as tl\nfrom cloudlib.thermo.constants import constants as c\n\n\ndef get_buoy(T: array, Td: array, pres: array) -> array:\n    \"\"\"\n    Given an atmospheric sounding (Temperature and dew point profiles),\n    calculate the buoyant force per unit mass (m/s2) of an air parcel\n    originating from the surface as as it ascends. Thompkins Eqn 1.61\n\n    Parameters\n    ----------\n    T, Td and press all need to be the same length\n\n    T:  Temperature profile (K)\n    Td:  Dew point temperature profile (K)\n    pres: Pressures at which to calculate B (Pa)\n\n    Returns\n    -------\n\n    B: Buoyancy per unit mass (m/s2)\n\n    \"\"\"\n    # initialize arrays\n    T_parcel = np.zeros_like(np.asarray(pres))\n    \n    ## 1) get the trajectory of the ascending parcel ##\n    Tsurf = T[0]\n    Tdsurf = Td[0]\n    psurf = pres[0]\n    theta_surf = tl.find_theta(Tsurf, c.p0)\n    Tlcl, plcl = tl.find_lcl(Tdsurf, Tsurf, psurf)\n\n    # trajectory below LCL follows dry adiabat\n    T_parcel[pres > plcl] = tl.make_dry_adiabat(theta_surf, pres[pres > plcl])\n    \n    # trajectory above LCL follows moist adiabat\n    thetaes = tl.find_thetaes(Tlcl, plcl)\n    T_parcel[pres <= plcl] = [tl.find_Tmoist(thetaes, p, use_theta=True) for p in pres[pres <= plcl]]\n\n    ## 2) calculate the buoyant force per unit mass\n    # get the virtual temperatures of the sounding and pseudo-adiabatic ascent\n    r_parcel = np.zeros_like(T_parcel)\n    r_parcel[pres > plcl] = tl.find_rsat(Tdsurf, psurf) # unsaturated ascent\n    r_parcel[pres <= plcl] = tl.find_rsat(T_parcel[pres <= plcl], pres[pres <= plcl]) # all water precipitates out\n    Tv_parcel = tl.find_Tv(T_parcel, r_parcel)\n   \n    r_env = tl.find_rsat(Td, pres)\n    Tv_env = tl.find_Tv(T, r_env)\n    \n    # Thompkins 1.61\n    buoy = c.g0 * (Tv_parcel - Tv_env) / Tv_env\n    return T_parcel, buoy","key":"mHOuwhdciV"},{"type":"outputs","id":"X0KE3rocmTveCOBNrU5wD","children":[],"key":"dIewMc1Nux"}],"key":"VVbHASsmn7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# convert pandas series to numpy  arrays with SI units and get buoyancy\ntemp = sounding['temp'].to_numpy() + c.Tc\ndwpt = sounding['dwpt'].to_numpy() + c.Tc\npres = sounding['pres'].to_numpy() * c.hPa2pa\nheight = sounding['hght'].to_numpy()\n\nT_parcel, buoy = get_buoy(temp, dwpt, pres)","key":"YH7Azmkkvf"},{"type":"outputs","id":"GaNOhcr96w0DnzadK0XX-","children":[],"key":"dyTNxrBQPT"}],"key":"Ivoed7vAdt"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"children":[{"type":"text","value":"plot the result","position":{"start":{"line":211,"column":1},"end":{"line":211,"column":1}},"key":"A3YoZzQiai"}],"identifier":"plot-the-result","label":"plot the result","html_id":"plot-the-result","implicit":true,"key":"fQQDk4dixv"}],"key":"HsvreEBNVp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# add parcel trajectory (pseudo-adiabatic)\nskew_parcel = convertTempToSkew(T_parcel - c.Tc, sounding.pres, skew)\nax.plot(skew_parcel, sounding.pres, \"k\", linewidth=2)\n\n# add subplot to show buoyant force/mass with height\ncutoff = sounding.pres > 200  # (hPa) \nax2 = fig.add_axes((1, 0.05, 0.3, 0.9), sharey=ax)\nax2.plot(buoy[cutoff], sounding.pres[cutoff])\nax2.axvline(0, color=\"k\", alpha=0.5, linestyle=\"--\")\nax2.set_xlabel(\"Buoyancy (m/s$^2$)\")\n\ndisplay(fig)","key":"UmMVGoanCC"},{"type":"outputs","id":"tMJjNccdjNF8CZddYK0nh","children":[],"key":"IYzyd81hls"}],"key":"a4Rf00nzSZ"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":228,"column":1},"end":{"line":228,"column":1}},"children":[{"type":"text","value":"Put this in a get_cape function","position":{"start":{"line":228,"column":1},"end":{"line":228,"column":1}},"key":"KS5KIw4w3H"}],"identifier":"put-this-in-a-get-cape-function","label":"Put this in a get_cape function","html_id":"put-this-in-a-get-cape-function","implicit":true,"key":"NStD9I5wDY"},{"type":"paragraph","position":{"start":{"line":230,"column":1},"end":{"line":230,"column":1}},"children":[{"type":"text","value":"We’ve got the buoyancy now we need to find the vertical limits on the force x distance integral","position":{"start":{"line":230,"column":1},"end":{"line":230,"column":1}},"key":"ziLhjqxvxS"}],"key":"L8C7cMlfkC"}],"key":"TZZ9m9fpO5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# get the distance bw each point\ncape_layers = np.diff(height)","key":"c8xMD3Auiq"},{"type":"outputs","id":"2iZ8z0vyuqpXsLjeicsra","children":[],"key":"neDwTtSH19"}],"key":"IaDbPGwlsl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# now we have a fencepost problem, one more buoy measurements than layers\n# so average right and left levels of each layer\nmid_buoy = (buoy[:-1] + buoy[1:])/2.\n#\n# get the positive values\n#\nhit_pos = mid_buoy > 0.","key":"Ovhd6n6TIQ"},{"type":"outputs","id":"RLx9p8E7AQDCLyQDfVrg1","children":[],"key":"Fdr6aczZFl"}],"key":"azYkSh5avo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# solve by averaging the bouyancy across each layer\nCAPE_elems = mid_buoy[hit_pos] * cape_layers[hit_pos] # F * dz\nCAPE = np.sum(CAPE_elems)","key":"u9pb4TWBe2"},{"type":"outputs","id":"NyWBfU4gI-x8dQIq5kDdo","children":[],"key":"UNVs3VLxhv"}],"key":"giK9qo0bgV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(f\"{CAPE=:.1f} J/kg\")","key":"AhLb9hEHLe"},{"type":"outputs","id":"JkOzDs5IvRs7RjCgwYC42","children":[],"key":"kskUFGUirg"}],"key":"X0vPAjiu1p"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":257,"column":1},"end":{"line":257,"column":1}},"children":[{"type":"text","value":"Put this in a function that takes in a sounding and calculates CAPE up to a specified cut pressure","position":{"start":{"line":257,"column":1},"end":{"line":257,"column":1}},"key":"JeY0sebiTU"}],"key":"RaLf3XIlJZ"}],"key":"BtmwcOaFa1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def get_CAPE(sounding: dict):\n    \"\"\"\n    calculates CAPE\n\n    Parameters\n    ----------\n\n    sounding: dictionary of pandas series from wyoming sounding\n\n    \"\"\"\n    temp = sounding[\"temp\"].to_numpy() + c.Tc\n    dwpt = sounding[\"dwpt\"].to_numpy() + c.Tc\n    pres = sounding[\"pres\"].to_numpy() * c.hPa2pa\n    levels = sounding['hght'].to_numpy()\n  \n    _, cape_buoy = get_buoy(temp, dwpt, pres)\n    mid_buoy = (cape_buoy[:-1] + cape_buoy[1:])/2.\n    cape_layers = np.diff(levels)\n    hit_pos = mid_buoy > 0\n    CAPE_elems = mid_buoy[hit_pos] * cape_layers[hit_pos]\n    CAPE = np.sum(CAPE_elems)\n    return CAPE","key":"MZ9bOSkzSq"},{"type":"outputs","id":"egxYwE-CDym-PkZxUI694","children":[],"key":"rSpdjQPYM5"}],"key":"al0OzGmkDw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"CAPE = get_CAPE(sounding)\nprint(f\"{CAPE=:0.1f} J/kg\")","key":"xrcEj1u9uK"},{"type":"outputs","id":"lHjIrnMR6smwF0Vbw-tAN","children":[],"key":"RdSIlXQtDo"}],"key":"HRcXtV1dPD"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":289,"column":1},"end":{"line":289,"column":1}},"children":[{"type":"text","value":"Compute the maximum vertical velocity","position":{"start":{"line":289,"column":1},"end":{"line":289,"column":1}},"key":"CkXR9Lvatf"}],"identifier":"compute-the-maximum-vertical-velocity","label":"Compute the maximum vertical velocity","html_id":"compute-the-maximum-vertical-velocity","implicit":true,"key":"sVWHiyMwrP"}],"key":"fKxppmO8Ug"},{"type":"block","position":{"start":{"line":291,"column":1},"end":{"line":291,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":293,"column":1},"end":{"line":293,"column":1}},"children":[{"type":"text","value":"Now, we want the maximum updraft velocity.  Ignoring the effects of entrainment and aerodynamic drag, we can use the relation from our buoyancy notes or Thompkins 3.4:","position":{"start":{"line":293,"column":1},"end":{"line":293,"column":1}},"key":"EMhjBZaF2D"}],"key":"E37xsMJHx9"},{"type":"math","value":"w_{max} = \\sqrt{2 \\,\\text{CAPE}}\\tag{AT3.4}","position":{"start":{"line":296,"column":1},"end":{"line":298,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mtable width=\"100%\"><mtr><mtd width=\"50%\"></mtd><mtd><mrow><msub><mi>w</mi><mrow><mi