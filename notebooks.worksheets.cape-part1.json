{"version":3,"kind":"Notebook","sha256":"559f49fb0ae9778e8fc0d83d63e4c7706ad0f5465e8b95e30c23d25f1967c3d9","slug":"notebooks.worksheets.cape-part1","location":"/notebooks/worksheets/cape_part1.md","dependencies":[],"frontmatter":{"title":"Cape Part 1  -- demo","kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"jupytext":{"formats":"ipynb,md:myst","text_representation":{"extension":".md","format_name":"myst","format_version":"0.13","jupytext_version":"1.19.1"}},"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Philip Austin","given":"Philip","family":"Austin"},"name":"Philip Austin","email":"paustin@eoas.ubc.ca","id":"contributors-myst-generated-uid-0","corresponding":true}],"github":"https://github.com/phaustin/e440_clouds","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/phaustin/e440_clouds/blob/main/notebooks/worksheets/cape_part1.md","edit_url":"https://github.com/phaustin/e440_clouds/edit/main/notebooks/worksheets/cape_part1.md","exports":[{"format":"md","filename":"cape_part1.md","url":"/a405/_public/cape_part1-b242e9f85dbad1edc5646d5a9d846936.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"This notebook shows how to calculate CAPE for soundings downloaded from the Wyoming website.  It does the CAPE integration described in Thompkins p. 49","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"s9TsqPSU8m"}],"key":"bc2zURJ1Sf"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"The download link: ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"YuxyrJvda6"},{"type":"link","url":"https://drive.google.com/file/d/1m8jSczibLnV7y_PvgdHvd7niFev1PXHJ/view?usp=sharing","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"cape_part1.ipynb","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"XX7ef74S7k"}],"urlSource":"https://drive.google.com/file/d/1m8jSczibLnV7y_PvgdHvd7niFev1PXHJ/view?usp=sharing","key":"q8IQyzrW42"}],"key":"YGnjFYy6W7"}],"key":"D7ZRZ95M9O"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport pandas as pd\nfrom pprint import pformat\n\nfrom cloudlib.thermo.constants import constants as c\nfrom cloudlib.thermo.thermfn import convertSkewToTemp, convertTempToSkew\nfrom cloudlib.skewT.fullskew import makeSkewWet,find_corners,make_default_labels","key":"JujaOz1cWH"},{"type":"outputs","id":"-9fraP10DHckgcvmv_vWF","children":[],"key":"ksjT3aNLss"}],"key":"EiCKGt7sGF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from cloudlib.soundings.wyominglib import write_soundings, read_soundings\nfrom matplotlib import pyplot as plt","key":"o3W492p6D7"},{"type":"outputs","id":"bD0XttC53YJx1wA3AbtvV","children":[],"key":"QBPBqiKreL"}],"key":"tUXo1IpkYo"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Grab a Little Rock sounding","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"VrdEWpK0aL"}],"identifier":"grab-a-little-rock-sounding","label":"Grab a Little Rock sounding","html_id":"grab-a-little-rock-sounding","implicit":true,"key":"JKzx47Tdga"}],"key":"RtZKhtJJAk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"write = False\nif write:\n    values=dict(region='naconf',year='2012',month='7',start='0100',stop='3000',station='72340')\n    write_soundings(values, 'littlerock')\n    soundings= read_soundings('littlerock')\ne