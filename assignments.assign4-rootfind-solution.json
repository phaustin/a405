osition":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Using a rootfinder to solve implicit equations","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"hrnArEgRH7"}],"key":"RH88nsSBDe"}],"key":"cbkhz1legp"},{"type":"block","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"We’ll need to use rootfinding to solve equations like finding the lifting condensation level, i.e. the level\nwhere the dewpoint=temperature.  This notebook works through a simple example and sets up question 1, which asks\nyou to use a rootfinder to find the dewpoint temperature for a given saturation vapor pressure","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"nAZ61aWPV4"}],"key":"ywTG5xrsIv"}],"key":"gH5kTmNXsV"},{"type":"block","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Documentation is here ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"JpIyNWP0r6"},{"type":"link","url":"https://docs.scipy.org/doc/scipy/reference/generated/scipy.optimize.brentq.html","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"scipy​.optimize​.brentq","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"C5OQzvimkm"}],"urlSource":"https://docs.scipy.org/doc/scipy/reference/generated/scipy.optimize.brentq.html","key":"Md30nJW5QU"}],"key":"JkyUrtrfn8"}],"key":"u5fhHsRhqy"},{"type":"block","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"The cell below shows how to use a rootfinder to solve the equation","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"WNIli81N4x"}],"key":"IB68NxvESB"},{"type":"math","value":"cos(x) - 0.75 = 0","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>c</mi><mi>o</mi><mi>s</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>0.75</mn><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">cos(x) - 0.75 = 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">cos</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.75</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span>","enumerator":"1","key":"QsSwcA6T3E"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The algorithm evaluates the function for increasing values of x until in sees a sign change.  It then backtracks to the other side of the sign change and starts increaing x again until it sees the sign change.  It will stop when the change in x is below a selected tolerance","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"tbq20eMMCc"}],"key":"uzsPHU23Dl"}],"key":"FmyD1kM4zc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy import optimize\nfrom matplotlib import pyplot as plt\nimport numpy as np\nplt.style.use('ggplot')\n\n\nxvals=np.linspace(0,10.)\nfig,ax = plt.subplots(1,1,figsize=(10,8))\nax.plot(xvals,np.cos(xvals))\nstraight_line=np.ones_like(xvals)\nax.plot(xvals,straight_line*0.75,'b-')\n\ndef root_function(x):\n    \"\"\"Function we want to find the root of\n       input: x value\n       output: y value -- should be zero when x is a root\n    \"\"\"\n    return np.cos(x) - 0.75\n\nroot1 = optimize.brentq(root_function,0,2)\nroot2 = optimize.brentq(root_function,4,6)\nroot3 = optimize.brentq(root_function,6,8)\nxvals=np.array([root1,root2,root3])\nyvals=np.cos(xvals)\nax.plot(xvals,yvals,'ro',markersize=20);","key":"EuLfXOUNrg"},{"type":"outputs","id":"6qOVc3cQv5zMPAr6N1bL5","children":[],"key":"QvRFFyusT5"}],"key":"uI1qQgYyke"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Problem 1 (part of assignment 4)","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"zJ6VWj6O4z"}],"identifier":"problem-1-part-of-assignment-4","label":"Problem 1 (part of assignment 4)","html_id":"problem-1-part-of-assignment-4","implicit":true,"key":"epEa4FkUPX"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Giventhe Clausius Clapeyron equation and a saturation vapor pressure  ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"oqwAkesaL8"},{"type":"inlineMath","value":"esat","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>e</mi><mi>s</mi><mi>a</mi><mi>t</mi></mrow><annotation encoding=\"application/x-tex\">esat</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6151em;\"></span><span class=\"mord mathnormal\">es</span><span class=\"mord mathnormal\">a</span><span class=\"mord mathnormal\">t</span></span></span></span>","key":"v482i2rX6j"},{"type":"text","value":" in Pa, find the dewpoint temperature in Kelvin, i.e. the temperature where:","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"Aq9zRBR5KL"}],"key":"W6rgRka1jO"},{"type":"code","lang":"","value":"esat = find_esat(Tdewpoint)","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"D6jcRAwLqk"}],"key":"htNdwbxhOM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def find_esat(temp):\n    \"\"\"\n    Thompkins 2.15 version of Clausius-Clapeyron equation\n    \n    Parameters\n    ----------\n\n    temp: temperature (K)\n\n    Returns\n    -------\n\n    esatOut: saturation vapor pressure (Pa)\n    \"\"\"\n    Tc = temp - 273.15\n    esatOut = 611.2 * np.exp(17.67 * Tc / (Tc + 243.5))\n    return esatOut","key":"ymTO7JHnH9"},{"type":"outputs","id":"0XFBtSrlUQJrx0U1MUo7M","children":[],"key":"vgxIH84M1N"}],"key":"iGH7XdpHDv"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"In the cell below, use the rootfinder to write this function:","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"iRfJKilcPX"}],"key":"sA6VZlKT40"},{"type":"code","lang":"","value":"def find_dewpoint(esat):\n   ...\n   return Tdew","position":{"start":{"line":98,"column":1},"end":{"line":100,"column":1}},"key":"DC28QDIFjt"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"and use it to make a plot of dewpoint vs temperature from 0 deg C to 30 deg C","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"nMnl6WQikZ"}],"key":"cSPYi64boV"}],"key":"PtCuunnwrm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# you code here\ndef root_function(Tdew,esat_target):\n    return esat_target - find_esat(Tdew)\n    \ndef find_dewpoint(esat):\n    Tdew = optimize.brentq(root_function,200,350,args=(esat,))\n    return Tdew\n    \nfind_dewpoint(1200)","key":"b22gR3QVjn"},{"type":"outputs","id":"xbnKzQtBdZrPubih2XzDJ","children":[],"key":"tWCzVseqOt"}],"key":"xTHHJqGb8X"},{"type":"block","children":[],"key":"WMRu6fsJOM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from a405.thermo.constants import constants as c\nimport numpy as np\nesat_vals = np.linspace(500, 4000, 50)\ndewpoint = [find_dewpoint(esat) for esat in esat_vals]\ndewpoint_tc = np.array(dewpoint) - c.Tc\nesat_vals_mb = np.array(esat_vals)*0.01\n\nplt.style.use('ggplot')\nfig, ax = plt.subplots(1,1,figsize = [8,6])\n\n# Plot values and convert the saturation vapour pressure to hPa\nax.plot(esat_vals_mb,dewpoint_tc)\nax.set_xlabel(\"Saturation vapor pressure (hPa)\")\nax.set_ylabel(\"Dewpoint temperature (°C)\")\nplt.grid(True)","key":"PUIQQO2jgm"},{"type":"outputs","id":"3sVr9MPaZ269f1uF8Jz6l","children":[],"key":"pmAktuH1lw"}],"key":"hVaLIfrswZ"},{"type":"block","children":[],"key":"dkobwQBNHW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"uwBGbNE18A"},{"type":"outputs","id":"LCISrl93nZc4_doZxrzy1","children":[],"key":"urKnIuv2UW"}],"key":"DMUVBgJgil"}],"key":"UHg5I3Z2EE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Assignment 3 solution: Analyzing a model cloud dataset","url":"/assignments/tropical-clouds-profiles-solution","group":"Assignments"},"next":{"title":"Assignment 4 part 2  -- solution","url":"/assignments/assignment4-paper-solution","group":"Assignments"}}},"domain":"http://pre.render"}