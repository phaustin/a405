"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Using a rootfinder to solve implicit equations","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"Rv3IBRVi5E"}],"key":"LwKq4MFAzu"}],"key":"F6sXsMF3IG"},{"type":"block","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"We’ll need to use rootfinding to solve equations like finding the lifting condensation level, i.e. the level\nwhere the dewpoint=temperature.  This notebook works through a simple example and sets up question 1, which asks\nyou to use a rootfinder to find the dewpoint temperature for a given saturation vapor pressure","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"xa42JQnueh"}],"key":"cQT9TpwoVF"}],"key":"oiEo0y8nlM"},{"type":"block","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Documentation is here ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"IreyusL51D"},{"type":"link","url":"https://docs.scipy.org/doc/scipy/reference/generated/scipy.optimize.brentq.html","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"scipy​.optimize​.brentq","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"OhwzDy1fbi"}],"urlSource":"https://docs.scipy.org/doc/scipy/reference/generated/scipy.optimize.brentq.html","key":"kzjgLgUxki"}],"key":"NALdlvT2SQ"}],"key":"R7K22fVBpF"},{"type":"block","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"The cell below shows how to use a rootfinder to solve the equation","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"aInftUeXeE"}],"key":"FliLZ9Mrk8"},{"type":"math","value":"cos(x) - 0.75 = 0","position":{"start":{"line":36,"column":1},"end":{"line":38,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>c</mi><mi>o</mi><mi>s</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>−</mo><mn>0.75</mn><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">cos(x) - 0.75 = 0</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">cos</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">x</span><span class=\"mclose\">)</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">−</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0.75</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">0</span></span></span></span></span>","enumerator":"1","key":"XKdLmQ2jt1"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"The algorithm evaluates the function for increasing values of x until in sees a sign change.  It then backtracks to the other side of the sign change and starts increaing x again until it sees the sign change.  It will stop when the change in x is below a selected tolerance","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"wQi3mZoZf7"}],"key":"m2rD4N1Mjq"}],"key":"ViwhKSF9wE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy import optimize\nfrom matplotlib import pyplot as plt\nimport numpy as np\nplt.style.use('ggplot')\n\n\nxvals=np.linspace(0,10.)\nfig,ax = plt.subplots(1,1,figsize=(10,8))\nax.plot(xvals,np.cos(xvals))\nstraight_line=np.ones_like(xvals)\nax.plot(xvals,straight_line*0.75,'b-')\n\ndef root_function(x):\n    \"\"\"Function we want to find the root of\n       input: x value\n       output: y value -- should be zero when x is a root\n    \"\"\"\n    return np.cos(x) - 0.75\n\nroot1 = optimize.brentq(root_function,0,2)\nroot2 = optimize.brentq(root_function,4,6)\nroot3 = optimize.brentq(root_function,6,8)\nxvals=np.array([root1,root2,root3])\nyvals=np.cos(xvals)\nax.plot(xvals,yvals,'ro',markersize=20);","key":"UZCgsHDIaJ"},{"type":"outputs","id":"IsQa5YLuvEUcTPHy1zjIW","children":[],"key":"pebD2rrqOJ"}],"key":"oOEwJu6NUm"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Problem 1 (part of assignment 4)","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"jhwyDLmLFD"}],"identifier":"problem-1-part-of-assignment-4","label":"Problem 1 (part of assignment 4)","html_id":"problem-1-part-of-assignment-4","implicit":true,"key":"ReatUnVltT"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Giventhe Clausius Clapeyron equation and a saturation vapor pressure  ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"IsGypntl3l"},{"type":"inlineMath","value":"esat","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>e</mi><mi>s</mi><mi>a</mi><mi>t</mi></mrow><annotation encoding=\"application/x-tex\">esat</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6151em;\"></span><span class=\"mord mathnormal\">es</span><span class=\"mord mathnormal\">a</span><span class=\"mord mathnormal\">t</span></span></span></span>","key":"Z4s9oIvV7U"},{"type":"text","value":" in Pa, find the dewpoint temperature in Kelvin, i.e. the temperature where:","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"pvSsyXrtae"}],"key":"iKeo122uU8"},{"type":"code","lang":"","value":"esat = find_esat(Tdewpoint)","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"NCER3L6uMC"}],"key":"d6ymAZ37rO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def find_esat(temp):\n    \"\"\"\n    Thompkins 2.15 version of Clausius-Clapeyron equation\n    \n    Parameters\n    ----------\n\n    temp: temperature (K)\n\n    Returns\n    -------\n\n    esatOut: saturation vapor pressure (Pa)\n    \"\"\"\n    Tc = temp - 273.15\n    esatOut = 611.2 * np.exp(17.67 * Tc / (Tc + 243.5))\n    return esatOut","key":"bvb3eopwoE"},{"type":"outputs","id":"pOi5GBMvCkcIu3RAmv_K8","children":[],"key":"tQUS0oWymO"}],"key":"viW8SG4q9j"},{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"children":[{"type":"text","value":"In the cell below, use the rootfinder to write this function:","position":{"start":{"line":96,"column":1},"end":{"line":96,"column":1}},"key":"IqKLjl1YZT"}],"key":"H10CmEEYsF"},{"type":"code","lang":"","value":"def find_dewpoint(esat):\n   ...\n   return Tdew","position":{"start":{"line":98,"column":1},"end":{"line":100,"column":1}},"key":"izOuuU1ZJW"},{"type":"paragraph","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"and use it to make a plot of dewpoint vs temperature from 0 deg C to 30 deg C","position":{"start":{"line":102,"column":1},"end":{"line":102,"column":1}},"key":"qmLCE5kMCH"}],"key":"JBZMMwRhsp"}],"key":"hVwDg3i3Ch"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# you code here\ndef root_function(Tdew,esat_target):\n    return esat_target - find_esat(Tdew)\n    \ndef find_dewpoint(esat):\n    Tdew = optimize.brentq(root_function,200,350,args=(esat,))\n    return Tdew\n    \nfind_dewpoint(1200)","key":"ZaALuXItCL"},{"type":"outputs","id":"pgvad9Os3AzefYYO_6qDc","children":[],"key":"ThYY4ty1uQ"}],"key":"QtQocnaXeF"},{"type":"block","children":[],"key":"WWhsB1yd11"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from cloudlib.thermo.constants import constants as c\nimport numpy as np\nesat_vals = np.linspace(500, 4000, 50)\ndewpoint = [find_dewpoint(esat) for esat in esat_vals]\ndewpoint_tc = np.array(dewpoint) - c.Tc\nesat_vals_mb = np.array(esat_vals)*0.01\n\nplt.style.use('ggplot')\nfig, ax = plt.subplots(1,1,figsize = [8,6])\n\n# Plot values and convert the saturation vapour pressure to hPa\nax.plot(esat_vals_mb,dewpoint_tc)\nax.set_xlabel(\"Saturation vapor pressure (hPa)\")\nax.set_ylabel(\"Dewpoint temperature (°C)\")\nplt.grid(True)","key":"SEYqcT5R5j"},{"type":"outputs","id":"Zx_KbtnAYPRu_bh3WRwAg","children":[],"key":"owE8he8efw"}],"key":"CLJGzo0hGF"},{"type":"block","children":[],"key":"s7ameiaLK7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"VAPoodmXSh"},{"type":"outputs","id":"EAzQQey3503GZwYfEZiNV","children":[],"key":"QUb7jjzf9w"}],"key":"Wj57sfIbVB"}],"key":"aeeJ2IJ7HE"},"