ntermediate points on this line show\nthe thermodynamic state of all mixtures of air at 900 hPa with air at 800 hPa","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"gDPg4op0Xv"}],"key":"YuAx5MWG2V"}],"data":{"jupyter":{"outputs_hidden":false}},"key":"r8xWDR9diL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## Blank tephigram","key":"Oi4tyRQuPb"},{"type":"outputs","id":"IMMPN-iBgULvRB32udHn-","children":[],"key":"D1OGH75BfO"}],"key":"UW4W2x1BRk"},{"type":"block","children":[],"key":"K9M3AH2g8u"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from cloudlib.thermo.thermfn import (find_Tmoist,find_rsat,\n                                  find_Td,tinvert_thetae,\n                                  convertTempToSkew,find_lcl)\nimport cloudlib.thermo.thermfn as tl\nfrom cloudlib.thermo.constants import constants as c\nfrom matplotlib import pyplot as plt\nimport numpy as np\npa2hPa=1.e-2\nfrom cloudlib.skewT.fullskew import makeSkewWet\nfig, ax = plt.subplots(1, 1, figsize=(12, 8))\nax, skew = makeSkewWet(ax,corners=[10,30])\nax.set(ylim=[1000,700])\nskewLimits = convertTempToSkew([10, 30], 1.e3, skew)\nout=ax.set(xlim=skewLimits)\nax.set_title(\"mixing line example\");","key":"kQaBDzL5MB"},{"type":"outputs","id":"DLEMGWzkaOafHeC3nVRPg","children":[],"key":"a12w1jRMfb"}],"key":"XkJu4YvxEQ"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Add mixing line points","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"D4Fte9qsxK"}],"identifier":"add-mixing-line-points","label":"Add mixing line points","html_id":"add-mixing-line-points","implicit":true,"key":"oDCqy0g5Ms"}],"key":"p5t4GVnCoW"},{"type":"block","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"heading","depth":3,"position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Find coords of lower point at its LCL","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"aCSRiGhqIS"}],"identifier":"find-coords-of-lower-point-at-its-lcl","label":"Find coords of lower point at its LCL","html_id":"find-coords-of-lower-point-at-its-lcl","implicit":true,"key":"EQupNv2kpM"}],"key":"veUgkjpnWA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"pa2hpa=1.e-2\nkg2g = 1.e3\npress=860.e2 #Pa  LCL\nthetae_900=338.  #K\nTemp_860=find_Tmoist(thetae_900,press)\nrv_860=find_rsat(Temp_860,press)  #just saturated at the LCL\nrv_900 = rv_860  #vapor is conserved\nTdew_860=Temp_860\nprint((f\"temp,Tdew,rv at LCL press:  {press*pa2hpa:0.1f} hPa\\n\"),\n      (f\"Temp: {Temp_860- c.Tc:.1f} deg C\\n\" ),\n      (f\"Tdew: {Tdew_860 - c.Tc:.1f} deg C\\n\"),\n      (f\"rv: {rv_860*kg2g:.1f} g/kg\"))","key":"QNkOAyaiwl"},{"type":"outputs","id":"Bl8AqwIkqZt9dnp_8ck3t","children":[],"key":"OCW0p8aNmw"}],"key":"UftrjD2rQd"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Now bring it down a moist adiabat to 900 hPa","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"P1Hhc1SvXk"}],"identifier":"now-bring-it-down-a-moist-adiabat-to-900-hpa","label":"Now bring it down a moist adiabat to 900 hPa","html_id":"now-bring-it-down-a-moist-adiabat-to-900-hpa","implicit":true,"key":"siNhLnYy08"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Add the temperature and dewpoint to the chart","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"Im95bW8pMs"}],"key":"uvTUpfqKhx"}],"key":"AMh7dpK9S0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#\n# now descend adiabatically to 900 hPa\n#\npress=900.e2\nTemp_900,rv_900,rl_900=tinvert_thetae(thetae_900,rv_900,press)\nTdew_900=find_Td(rv_900,press)\nprint((f\"temp,Tdew,rv at LCL press:  {press*pa2hpa:0.1f} hPa\\n\"),\n      (f\"Temp: {Temp_900- c.Tc:.1f} deg C\\n\" ),\n      (f\"Tdew: {Tdew_900 - c.Tc:.1f} deg C\\n\"))\n#\n#  draw these on the sounding at 900 hPa as a red circle and blue diamond\n#\nxplot=convertTempToSkew(Temp_900 - c.Tc,press*pa2hPa,skew)\nbot=ax.plot(xplot, press*pa2hPa, 'ro', markersize=14, markerfacecolor='r')\nxplot=convertTempToSkew(Tdew_900 - c.Tc,press*pa2hPa,skew)\nbot=ax.plot(xplot, press*pa2hPa, 'bd', markersize=14, markerfacecolor='b')\n#\n# add the LCL\n#\npress=860.e2\nxplot=convertTempToSkew(Temp_860 - c.Tc,press*pa2hPa,skew)\nbot=ax.plot(xplot, press*pa2hPa, 'ko', markersize=14, markerfacecolor='k')\ndisplay(fig)","key":"ZrwdNoIncq"},{"type":"outputs","id":"iKm2RHBhkoOhf_pekXeyk","children":[],"key":"u17MzoIB4t"}],"key":"uCDvIWhOiH"},{"type":"block","children":[{"type":"heading","depth":3,"position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"children":[{"type":"text","value":"Find coords of upper point at its LCL","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"MdZ05yxw8U"}],"identifier":"find-coords-of-upper-point-at-its-lcl","label":"Find coords of upper point at its LCL","html_id":"find-coords-of-upper-point-at-its-lcl","implicit":true,"key":"KeCLNp6D6B"},{"type":"paragraph","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"LCL is 700 hPa and ","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"zq92BZXuac"},{"type":"inlineMath","value":"\\theta_e","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>θ</mi><mi>e</mi></msub></mrow><annotation encoding=\"application/x-tex\">\\theta_e</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8444em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">θ</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.1514em;\"><span style=\"top:-2.55em;margin-left:-0.0278em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">e</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"PxfZWsMPaQ"},{"type":"text","value":" is 332 K","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"YCUWWwsgyY"}],"key":"LGL8c7OLQj"}],"key":"aYNtO0FDEj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"press=700.e2  #LCL Pa\nthetae_800=332.  #K\nTemp_700=find_Tmoist(thetae_800,press)\nTdew_700 = Temp_700\nrv_700=find_rsat(Temp_700,press)\nprint((f\"temp,Tdew,rv at LCL press:  {press*pa2hpa:0.1f} hPa\\n\"),\n      (f\"Temp: {Temp_700- c.Tc:.1f} deg C\\n\" ),\n      (f\"Tdew: {Tdew_700- c.Tc:.1f} deg C\\n\"),\n      (f\"rv: {rv_700*kg2g:.1f} g/kg\\n\"))\n# get the temperature and dewpoint at 800 hPa\n#\npress=800.e2\nrv_800=rv_700   #total water is conserved\nTemp_800,rv_800,rl=tinvert_thetae(thetae_800,rv_800,press)\nTdew_800=find_Td(rv_800,press)\nprint((f\"temp,Tdew,rv at LCL press:  {press*pa2hpa:0.1f} hPa\\n\"),\n      (f\"Temp: {Temp_800- c.Tc:.1f} deg C\\n\" ),\n      (f\"Tdew: {Tdew_800 - c.Tc:.1f} deg C\\n\"))\n#\n# put these points on the sounding at 800 hPa\n#\nxplot=convertTempToSkew(Temp_800 - c.Tc,press*pa2hPa,skew)\nbot=ax.plot(xplot, press*pa2hPa, 'ro', markersize=14, markerfacecolor='r')\nxplot=convertTempToSkew(Tdew_800 - c.Tc,press*pa2hPa,skew)\nbot=ax.plot(xplot, press*pa2hPa, 'bd', markersize=14, markerfacecolor='b')\npress = 700e2\nxplot=convertTempToSkew(Temp_700 - c.Tc,press*pa2hPa,skew)\nbot=ax.plot(xplot, press*pa2hPa, 'ko', markersize=14, markerfacecolor='k')\ndisplay(fig)\nfig.savefig('mid-tephi.pdf')","key":"gjmD8364vJ"},{"type":"outputs","id":"7N_MxnpPqBPRzVd-iIcTt","children":[],"key":"RdW6mU7rgr"}],"key":"K2aHa2rp3I"},{"type":"block","children":[],"key":"TZhSfbEgWw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#x=\n#y=\nw=13.3\nz=8.3\n#thetae_mix = 0.5*x + 0.5*y\nrv_mix = 0.5*w + 0.5*z\nrv_mix","key":"QuX7Zld0KW"},{"type":"outputs","id":"Aq7_Zp7xNyHdBOkaolmre","children":[],"key":"zN8ZDYXjIU"}],"key":"SlZnIZZ9SQ"},{"type":"block","children":[],"key":"YTd178gZyK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"u3qpz7EepK"},{"type":"outputs","id":"rjrpsLJX89E5ghGZOjOD7","children":[],"key":"DoCTvZWNlM"}],"key":"hyAdRKpQAI"}],"key":"uTlfdFEVpZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Worksheet 6 solution: Gibbs free energy","url":"/notebooks/worksheets/worksheet6-gibbs-solution","group":"Worksheets"},"next":{"title":"Convective instability -- lifting demo","url":"/notebooks/worksheets/convec-instability","group":"Worksheets"}}},"domain":"http://pre.render"}